{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fusion LCSC Library Manager",
  "version": "0.0.2",
  "identifier": "de.makerspace-darmstadt.fusion-lcsc-library-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fusion LCSC Library Manager",
        "width": 1100,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "trusted-signing-cli",
        "args": [
          "-e",
          "https://weu.codesigning.azure.net",
          "-a",
          "mksp-trusted-signing",
          "-c",
          "MKSP-Windows-Signature",
          "-d",
          "Fusion LCSC Library Manager",
          "%1"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
